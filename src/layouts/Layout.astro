---
const { title, description, keywords, image = "/og-image.jpg", type = "website" } = Astro.props;
const currentPath = Astro.url.pathname;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteName = "Yilong Scrubs";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppIcon from "../components/WhatsAppIcon.astro";
import AutoTranslator from "../components/AutoTranslator.astro";

// Organization Schema
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Yilong Scrubs",
  "alternateName": "Anhui Yilong Environmental Protection Technology Co., Ltd.",
  "url": Astro.site,
  "foundingDate": "1994",
  "hasCredential": [
    { "@type": "EducationalOccupationalCredential", "name": "OEKO-TEX Standard 100" },
    { "@type": "EducationalOccupationalCredential", "name": "ISO 9001:2015" },
    { "@type": "EducationalOccupationalCredential", "name": "ISO 14001:2015" },
    { "@type": "EducationalOccupationalCredential", "name": "ISO 45001:2018" }
  ]
};

// BreadcrumbList Schema (dynamic based on current page)
const labelMap = {
  'about-us': 'About Us', 'about': 'About', 'products': 'Products',
  'fabric-technology': 'Fabric Technology', 'fabric-tech': 'Fabric Technology',
  'catalog': 'Catalog', 'contact': 'Contact', 'services': 'Services',
  'size-guide': 'Size Guide', 'ready-to-ship': 'Ready to Ship'
};
const breadcrumbItems = [{ "@type": "ListItem", "position": 1, "name": "Home", "item": Astro.site + "/" }];
if (currentPath && currentPath !== '/') {
  const parts = currentPath.split('/').filter(Boolean);
  parts.forEach((seg, i) => {
    breadcrumbItems.push({
      "@type": "ListItem",
      "position": i + 2,
      "name": labelMap[seg] || seg.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase()),
      "item": Astro.site + "/" + parts.slice(0, i + 1).join('/')
    });
  });
}
const breadcrumbSchema = { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": breadcrumbItems };
---
<html lang="en">
<head>
<meta charset="utf-8" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<meta name="viewport" content="width=device-width" />
<meta name="generator" content={Astro.generator} />
<title>{title} | Yilong scrubs</title>
<meta name="description" content={description} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.site)} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="en_US" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image, Astro.site)} />

<!-- hreflang (English default) -->
<link rel="alternate" hreflang="en" href={new URL(Astro.url.pathname, Astro.site)} />
<link rel="alternate" hreflang="x-default" href={new URL(Astro.url.pathname, Astro.site)} />
<!-- Google Analytics -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-RLMP6J7LW7"></script>
<script is:inline>
if(!window.dataLayer) window.dataLayer = [];
function gtag(){window.dataLayer.push(arguments);}
gtag("js", new Date());
gtag("config", "G-RLMP6J7LW7");
</script>
<!-- Organization Schema -->
<script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
<!-- BreadcrumbList Schema -->
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</head>
<body class="bg-slate-50 text-slate-900 flex flex-col min-h-screen">
<Header />
<main class="flex-grow">
<slot />
</main>
<AutoTranslator />
<WhatsAppIcon />
<Footer />

<!-- OKKI CRM Analytics - Inquiry Form Sync -->
<script is:inline>
 window.okkiConfigs = window.okkiConfigs || [];
 function okkiAdd() { okkiConfigs.push(arguments); };
 okkiAdd("analytics", { siteId: "81933-32244", gId: "" });
</script>
<script async src="//tfile.xiaoman.cn/okki/analyze.js?id=81933-32244-"></script>
</body>
</html>